// Item 435(c) — the code-point decode behind the `Str` helpers is memoised, so
// an index scan over a string is LINEAR in the string's length.
//
// `revlLen` / `revlCharAt` / `revlCharCodeAt` / `revlSlice` all index a string's
// code-point decomposition (docs/strings.md: a `Str` is code points, a JS string
// is UTF-16). Each used to call `Array.from` itself, so the idiomatic scan below
// — whose `while` condition re-evaluates `s.length()` every iteration — built and
// threw away the whole array 2n + 1 times, materialising 2n^2 + n code points to
// read n of them. `tests/str_scan_memo.test.ts` counts them by executing this.
//
// `mixed` is here so the count is checked on astral characters too, where code
// points and UTF-16 code units genuinely differ and the decode is doing real work.
//
// Regenerate with:
//   python3 -c "import json,sys; sys.path.insert(0,'src'); from revl import compile_source; \
//     print(json.dumps(compile_source(open('backends/typescript/tests/fixtures/str_scan.rvl').read()), indent=2))" \
//     > backends/typescript/tests/fixtures/str_scan.ir.json

pub fn count_digits(s: Str) -> Int {
  var n = 0
  var i = 0
  while (i < s.length()) {
    if (s.charAt(i).is_digit()) { n = n + 1 }
    i = i + 1
  }
  return n
}

pub fn checksum(s: Str) -> Int {
  var acc = 0
  var i = 0
  while (i < s.length()) {
    acc = (acc + s.charCodeAt(i)).mod(65536)
    i = i + 1
  }
  return acc
}

// A pairwise scan: two distinct strings alternating through the helpers. This is
// why the memo has more than one slot: with one it would thrash back to the
// pre-435(c) cost on this shape, which is common (compare, merge, diff).
pub fn common_prefix(a: Str, b: Str) -> Int {
  var i = 0
  while (i < a.length()) {
    if (i >= b.length()) { return i }
    if (a.charAt(i) != b.charAt(i)) { return i }
    i = i + 1
  }
  return i
}

// Issue #2313: an index scan whose body also reads other strings. With a
// two-slot memo the two one-character literals evicted `text` on every pass,
// so the scan decoded `text` again each time and went quadratic.
pub fn count_marks(text: Str) -> Int {
  var n = 0
  var i = 0
  while (i < text.length()) {
    let c = text.charAt(i)
    if (c == "<".charAt(0) || c == ">".charAt(0)) { n = n + 1 }
    i = i + 1
  }
  return n
}

// Issue #2313: three long strings read round-robin on every pass. Short-string
// bypass alone does not keep this linear; the memo must hold all three.
pub fn agree_three(a: Str, b: Str, c: Str) -> Int {
  var n = 0
  var i = 0
  while (i < a.length() && i < b.length() && i < c.length()) {
    if (a.charAt(i) == b.charAt(i)) { n = n + 1 }
    if (b.charAt(i) == c.charAt(i)) { n = n + 1 }
    if (c.charAt(i) == a.charAt(i)) { n = n + 1 }
    i = i + 1
  }
  return n
}

// Direct handles on each Str helper, so a test can compare their answers with
// a code-point reference on astral strings and lone surrogates.
pub fn len_of(s: Str) -> Int {
  return s.length()
}

pub fn char_at(s: Str, i: Int) -> Str {
  return s.charAt(i)
}

pub fn code_at(s: Str, i: Int) -> Int {
  return s.charCodeAt(i)
}

pub fn slice_of(s: Str, a: Int, b: Int) -> Str {
  return s.slice(a, b)
}
