// idiom: secret-value
// summary: `Secret[T]` is a value the program holds and computes with; it differs from `secret NAME for CAP`, whose key the program never holds
// rule: a `Secret[T]` (origin `confidential`) is refused at every disclosure sink (a log, a prompt, an undeclared receiver, an MCP return) and crosses only to a declared `Secret[T]` parameter; the only way out is a declared `endorse[confidential]` slot with a `reason`
// rule: it is disjoint from the bound key (origin `secret`, no declassifier): `endorse[secret]` is refused and a `Secret[T]` receiver never admits the bound key, so reach for `secret NAME for CAP` for a provider key and `Secret[T]` for a token the program passes between its own emissions
// fill: endorse[confidential](token, reason = "charge settled")

service Vault { emission[vault.mint] fn get() -> Secret[Str] }

service Ops { emission endorse[confidential] fn settle() -> Str }

component Payer requires vault: Vault provides ops: Ops {
  provide ops {
    fn settle() {
      let token = emit vault.get()
      return endorse[confidential](token, reason = "charge settled")
    }
  }
}
